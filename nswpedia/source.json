{
  "id": "nswpedia",
  "name": "NSWpedia",
  "version": "3.1.0",
  "type": "python",
  "description": "Sorgente per scaricare ROM Nintendo Switch da NSWpedia.com",
  "author": "Tottodrillo Team",
  "pythonScript": "nswpedia_source.py",
  "minAppVersion": "3.1.0",
  "baseUrl": "https://nswpedia.com",
  "defaultImage": "nswpedia/placeholder.png",
  "downloadInterceptPatterns": [
    "download.nswpediax.site",
    "?token="
  ],
  "requiresCloudflareBypass": true,
  "cloudflareBypassConfig": {
    "delaySeconds": 20,
    "extractUrlPattern": null,
    "cookieDomains": ["nswpedia.com", "download.nswpediax.site"]
  },
  "webViewConfig": {
    "delaySeconds": 20,
    "extractUrlScript": null,
    "interceptPatterns": ["download.nswpediax.site", "?token="],
    "requiresCookieExtraction": true
  },
  "requiresCustomCookieManager": true
}

